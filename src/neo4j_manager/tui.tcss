BusyScreen, ConfirmScreen, MessageScreen, CreateInstanceScreen, RemoveConfirmScreen {
    align: center middle;
}

/* textual.containers.Horizontal defaults to height: 1fr, which is meant
   for filling a fixed viewport alongside sibling rows. Every Horizontal
   in this app is just a row of buttons/widgets that should be as tall as
   its content -- left at 1fr inside a VerticalScroll (whose height is
   itself "auto", derived from its children) it collapses to a sliver and
   gets clipped by the container's own `overflow: hidden hidden`, making
   the row disappear entirely regardless of scrolling. */
Horizontal {
    height: auto;
}

#busy-box {
    width: 40%;
    height: auto;
    border: round $primary;
    padding: 1 2;
    background: $panel;
    align: center middle;
}

#confirm-box, #message-box, #form-box {
    width: 60%;
    max-width: 80;
    height: auto;
    max-height: 90%;
    border: round $primary;
    padding: 1 2;
    background: $panel;
}

#detail-box {
    padding: 1 2;
}

.title {
    text-style: bold;
    margin-bottom: 1;
}

.section-title {
    text-style: bold;
    margin-top: 1;
    color: $accent;
}

.error {
    border: round $error;
}

Button {
    margin-right: 1;
    margin-top: 1;
}

Input {
    margin-bottom: 1;
}
